<Application
  x:Class="ContextSwitcher.App.App"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ContextSwitcher/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ContextSwitcher/Styles/Typography.axaml" />
    <StyleInclude Source="avares://ContextSwitcher/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
