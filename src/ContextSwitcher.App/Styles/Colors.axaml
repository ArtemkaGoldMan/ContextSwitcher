<!--
  The app's palette. Deliberately small:
    - neutrals for surfaces, text and lines (the greys of macOS itself);
    - one accent, the system blue, for links, primary buttons, selection and every icon badge;
    - three status colours - success, warning, error - each with a soft tint for backgrounds.
  Profile colours are the user's own choice and not part of this; they live with each profile.

  There used to be five badge gradients (blue, purple-to-pink, green-to-cyan, orange, grey) and
  twelve solid badge colours, so each page header had a colour of its own and the app read as a
  patchwork. Every badge is the accent now; anything new picks from the tokens here.
-->
<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Surfaces, back to front: window < sidebar < card. -->
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF2F2F5" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#FFF7F7F9" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#FFF6F6F8" />
      <SolidColorBrush x:Key="SelectedNavBrush" Color="#14000000" />
      <SolidColorBrush x:Key="BorderBrush" Color="#12000000" />
      <SolidColorBrush x:Key="DividerBrush" Color="#0C000000" />

      <!-- Text. -->
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1D1D1F" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6E6E73" />

      <!-- The one accent. -->
      <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />

      <!-- Status, and the soft tints status pills sit on. -->
      <SolidColorBrush x:Key="SuccessBrush" Color="#FF1E8E3E" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFB25000" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FFD1392B" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2630D158" />
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#26FF453A" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#268E8E93" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF19191B" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#FF1C1C1F" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F0242426" />
      <SolidColorBrush x:Key="CardBrush" Color="#FF29292C" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#FF303033" />
      <SolidColorBrush x:Key="SelectedNavBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="BorderBrush" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9C9CA3" />

      <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />

      <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CD964" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FFFFA033" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#FFFF6961" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2E30D158" />
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#2EFF453A" />
      <SolidColorBrush x:Key="NeutralSoftBrush" Color="#2E8E8E93" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- A hairline drawn on top of the accent itself - the ring that keeps a profile's badge visible
       on the accent-filled button of the active profile. The same in both themes, since the accent is. -->
  <SolidColorBrush x:Key="OnAccentRingBrush" Color="#59FFFFFF" />
</ResourceDictionary>
