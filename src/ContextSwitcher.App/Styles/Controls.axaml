<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:ContextSwitcher.App.Controls">
  <Styles.Resources>
    <!-- One width for every value control in a FormRow - dropdowns and text boxes alike - so the
         right-hand column is a single straight edge on every page. Wide enough for the longest
         Focus entry ("Reduce Interruptions  Needs Shortcut"). -->
    <x:Double x:Key="FieldWidth">280</x:Double>

    <!-- One width for every "add from a list" flyout: apps, open tabs, containers. -->
    <x:Double x:Key="PickerWidth">340</x:Double>
  </Styles.Resources>

  <!-- A labelled setting: label (and optional explanation) left, control right. See FormRow.cs. -->
  <Style Selector="ctl|FormRow">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" MinHeight="32">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="{TemplateBinding Title}" Classes="body" TextWrapping="Wrap" />
            <TextBlock
              Text="{TemplateBinding Description}"
              Classes="caption"
              TextWrapping="Wrap"
              IsVisible="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <ContentPresenter
            Grid.Column="1"
            Name="PART_ContentPresenter"
            Content="{TemplateBinding Content}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            VerticalAlignment="Center"
            HorizontalAlignment="Right" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Every value control sitting directly in a row is the same width; the class covers the few
       that need a wrapper (a dropdown with something revealed under it). -->
  <Style Selector="ctl|FormRow > ComboBox, ctl|FormRow > TextBox, ComboBox.field, TextBox.field">
    <Setter Property="Width" Value="{StaticResource FieldWidth}" />
  </Style>
  <!-- Card surface: the base building block for every section on every page. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Emphasized card, e.g. the active profile's row. The border stays 1px like every other card
       and only its colour changes: a thicker border shrinks the content box, and with layout
       rounding that moved the whole Activate/Edit/Duplicate/Delete cluster a pixel sideways on
       whichever row happened to be active. Compensating with half-pixel padding does not survive
       the rounding, so the accent colour carries the emphasis on its own. -->
  <Style Selector="Border.panel.current">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- The main window's notice about a switch that had problems: an ordinary card, lifted off the
       page by a shadow because it sits over the bottom of the window rather than in the list. Its
       badge carries the status colour - amber for warnings, red when the switch did not happen. -->
  <Style Selector="Border.panel.notice">
    <Setter Property="BoxShadow" Value="0 4 14 0 #1F000000" />
  </Style>

  <Style Selector="Border.panel.notice Border.noticeBadge">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.panel.notice.failure Border.noticeBadge">
    <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!-- Thin horizontal rule used to separate rows inside a card instead of nesting boxes. -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- Small status chip (permission allowed / not allowed / checking), tinted from the palette's soft
       status colours by class rather than by colours written into code. -->
  <Style Selector="Border.statusPill">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
  </Style>

  <Style Selector="Border.statusPill.allowed">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
  </Style>

  <Style Selector="Border.statusPill.denied">
    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
  </Style>

  <!-- Collapsible group of cards (Profile Setup's Environment/Advanced tiers). Transparent so the
       cards inside keep their own surfaces rather than nesting a card in a card. -->
  <Style Selector="Expander.section">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Expander.section /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Padding" Value="0,12,0,0" />
  </Style>

  <!-- Colored rounded-square icon badge (nav rows, page/section headers). Size and background
       are set per-instance; this only fixes the shape and centers the glyph. -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="9" />
  </Style>

  <Style Selector="Border.badge > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Border.badge > Viewbox">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Primary/pill button: neutral by default, filled accent when Classes="current" marks it as
       the active/primary choice (Save, Add, the active Dashboard switch button, a selected
       Week/Month segment). -->
  <Style Selector="Button.switchContext">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.switchContext:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
  </Style>

  <Style Selector="Button.switchContext.current">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.switchContext.current:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button.switchContext:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.iconButton">
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
  </Style>

  <!-- Text-only action; accent-colored so it reads as a link, matching macOS convention. Every
       "+ Add …" in the app is one of these. A link is never stretched: one that was sat centred in
       its row while every other link hugged the left edge. -->
  <Style Selector="Button.linkButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Hover and press only dim the text. Semi gives every button a grey box on hover, which put a
       box behind a link the moment the pointer passed over it. -->
  <Style Selector="Button.linkButton:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.linkButton:pressed /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- A link that should not compete with the main one beside it ("Skip setup", the dashboard's
       "Support the developer"). -->
  <Style Selector="Button.linkButton.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- One row in any list of things a profile holds - apps, URLs, tab groups, containers, quick
       links, browser profiles - in Profile Setup and in onboarding alike: a leading icon, the name,
       any toggles, and the remove button, all inside the same card. -->
  <Style Selector="Border.listRow">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <!-- Text typed inside a list row: no box of its own, since the row already is one. -->
  <Style Selector="TextBox.inRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox.inRow:pointerover /template/ Border#PART_ContentPresenterBorder, TextBox.inRow:focus /template/ Border#PART_ContentPresenterBorder">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- An entry in an "add from a list" flyout. Drawn like a dropdown's entry - regular weight, the
       same height and hover - so picking an app and picking a Focus mode feel like the same act. -->
  <Style Selector="Button.pickerItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.pickerItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
  </Style>

  <!-- Main App window's left-hand page navigation (agent.md section 11.1.2). -->
  <Style Selector="Button.navItem">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- Semi themes borderless buttons with accent-colored text; nav labels must stay neutral
         so the colored badge is the only accent in the rail. -->
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.navItem.active">
    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
  </Style>

  <Style Selector="Button.navItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
  </Style>

  <!-- Small secondary row action (edit/duplicate/delete icons on Profiles rows). -->
  <Style Selector="Button.rowAction">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- Neutral by default so a row's destructive action (Delete, which sets its own red) is the
         only colored control in the row. -->
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.rowAction:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Destructive row action. Must be a class, not an inline Foreground: a class-level setter on
       Button.rowAction wins over an inline DynamicResource, so inline red silently disappeared. -->
  <Style Selector="Button.rowAction.danger">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="Button.rowAction.danger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
  </Style>

  <!-- Lucide icons are drawn on a 24x24 grid, stroked at 2px, never filled. The Path keeps that
       grid (Stretch=None at 24x24) and the Viewbox around it does the scaling, so every icon
       shrinks by the same factor and its stroke scales with it.

       Sizing each Path with Stretch="Uniform" instead normalised every icon to its own bounding
       box rather than to the shared grid, so an icon deliberately drawn small inside that grid
       came out larger than one that fills it: x, whose geometry is 12x12, rendered half again the
       size of the 18x18 icons beside it. Scaling here also removes the per-size-class stroke
       thicknesses that were compensating for Stretch not scaling the stroke. -->
  <Style Selector="Viewbox.icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <Style Selector="Viewbox.icon.lg">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
  </Style>

  <Style Selector="Viewbox.icon.rowAction">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
  </Style>

  <Style Selector="Path.glyph">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Stroke" Value="White" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- An icon drawn on a neutral tile rather than a colored badge, e.g. the unselected icon choices. -->
  <Style Selector="Viewbox.icon.muted Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- Row actions sit on the page rather than inside a coloured badge, so the glyph takes the
       secondary text colour instead of white. -->
  <Style Selector="Viewbox.icon.rowAction Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- The leading icon of a list row, picker entry or dropdown entry: an app's own icon, a swatch,
       or a glyph for the kind of thing it is. Always this slot, so names line up whatever the icon.
       After Path.glyph on purpose: of two matching styles the later one wins, and Path.glyph's
       white stroke - meant for colored badges - left these glyphs invisible on a light row. -->
  <Style Selector="Panel.leadingIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Panel.leadingIcon Viewbox.icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Panel.leadingIcon Path.glyph">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- No raw TextBox/ComboBox/Button styling here on purpose: Semi.Avalonia already themes every
       standard control, and overriding its templates is what made the previous hand-rolled pass
       look inconsistent. Only add a rule here if it is genuinely app-specific. -->
</Styles>
