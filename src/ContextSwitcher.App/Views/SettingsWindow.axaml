<Window
  x:Class="ContextSwitcher.App.Views.SettingsWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Context Switcher Settings"
  Width="860"
  Height="620"
  WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Settings" Classes="header" />
    <TextBlock
      Classes="body"
      TextWrapping="Wrap"
      Text="The full settings editor (contexts, browser profiles, hotkeys, automation permissions, analytics retention) is not built yet. Edit ~/.config/ContextSwitcher/settings.json directly for now." />
  </StackPanel>
</Window>
