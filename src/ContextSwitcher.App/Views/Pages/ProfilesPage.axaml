<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.ProfilesPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="using:ContextSwitcher.App.Resources"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:conv="using:ContextSwitcher.App.Converters"
  x:DataType="vm:ProfilesViewModel">
  <StackPanel Spacing="20">
    <!-- Same header as every page: its badge, its title, its action. -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0" Classes="badge" Width="36" Height="36" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
        <Viewbox Classes="icon" Width="18" Height="18">
          <Path Classes="glyph" Data="{StaticResource IconLayoutGrid}" />
        </Viewbox>
      </Border>
      <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Profiles_Profiles}" Classes="header" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="switchContext current" Content="{x:Static r:Strings.Profiles_AddNewProfile}" Command="{Binding AddCommand}" />
    </Grid>

    <TextBlock
      Text="{Binding ErrorMessage}"
      Classes="caption"
      Foreground="{DynamicResource ErrorBrush}"
      TextWrapping="Wrap"
      IsVisible="{Binding HasErrorMessage}" />

    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProfileRowViewModel">
          <!-- The card's own surface, edged in the profile's colour while it's on; inside it, a wash of
               that colour over the whole card, padding and all - laid over the card rather than
               instead of it, so the card stays white (or dark) under the tint. -->
          <Border Classes="panel profileCard" Classes.current="{Binding IsActive}">
            <Border Classes="profileCardTint" Background="{Binding CardTint}">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- The profile itself is the switch: a click turns it on, or off when it's the one on. -->
                <Button
                  Grid.Column="0"
                  Classes="profileToggle"
                  Command="{Binding ToggleCommand}"
                  ToolTip.Tip="{Binding ToggleToolTip}"
                  AutomationProperties.Name="{Binding DisplayName}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{Binding AccentBrush}" Margin="0,0,14,0">
                      <Viewbox Classes="icon" Width="18" Height="18">
                        <Path Classes="glyph" Data="{Binding Icon, Converter={x:Static conv:ProfileIconConverter.Instance}}" />
                      </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding DisplayName}" Classes="body" FontWeight="{Binding NameWeight}" />
                      <TextBlock Text="{x:Static r:Strings.Profiles_ActiveNow}" Classes="caption" Foreground="{Binding AccentBrush}" FontWeight="SemiBold" IsVisible="{Binding IsActive}" />
                    </StackPanel>
                  </Grid>
                </Button>

                <Button Grid.Column="1" Classes="rowAction" Command="{Binding EditCommand}" ToolTip.Tip="{x:Static r:Strings.Profiles_Edit}" Content="{x:Static r:Strings.Profiles_Edit}" Margin="12,0,0,0" />

                <Button Grid.Column="2" Classes="rowAction" Command="{Binding DuplicateCommand}" ToolTip.Tip="{x:Static r:Strings.Profiles_Duplicate}" Content="{x:Static r:Strings.Profiles_Duplicate}" Margin="4,0,0,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" IsVisible="{Binding !IsConfirmingDelete}">
                  <Button Classes="rowAction danger" Command="{Binding DeleteCommand}" ToolTip.Tip="{x:Static r:Strings.Profiles_Delete}" Content="{x:Static r:Strings.Profiles_Delete}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" IsVisible="{Binding IsConfirmingDelete}">
                  <TextBlock Text="{x:Static r:Strings.Profiles_Delete2}" Classes="caption" VerticalAlignment="Center" />
                  <Button Classes="rowAction danger" Command="{Binding DeleteCommand}" Content="{x:Static r:Strings.Profiles_Yes}" />
                  <Button Classes="rowAction" Command="{Binding CancelDeleteCommand}" Content="{x:Static r:Strings.Profiles_No}" />
                </StackPanel>
              </Grid>
            </Border>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
