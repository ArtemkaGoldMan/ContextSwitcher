<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.ProfilesPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  x:DataType="vm:ProfilesViewModel">
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Profiles" Classes="header" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="switchContext current" Content="+ Add new profile" Command="{Binding AddCommand}" />
    </Grid>

    <TextBlock
      Text="{Binding ErrorMessage}"
      Classes="caption"
      Foreground="{DynamicResource ErrorBrush}"
      TextWrapping="Wrap"
      IsVisible="{Binding HasErrorMessage}" />

    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProfileRowViewModel">
          <Border Classes="panel" Classes.current="{Binding IsActive}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
              <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="{Binding AccentBrush}" Margin="0,0,14,0">
                <Ellipse Width="10" Height="10" Fill="White" Opacity="0.9" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding DisplayName}" Classes="body" FontWeight="Medium" />
                <TextBlock Text="Active now" Classes="caption" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsActive}" />
              </StackPanel>

              <Button
                Grid.Column="2"
                Classes="switchContext"
                Command="{Binding ActivateCommand}"
                Content="Activate"
                IsEnabled="{Binding !IsActive}"
                Margin="6,0" />

              <Button Grid.Column="3" Classes="rowAction" Command="{Binding EditCommand}" ToolTip.Tip="Edit" Content="Edit" Margin="4,0,0,0" />

              <Button Grid.Column="4" Classes="rowAction" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate" Content="Duplicate" Margin="4,0,0,0" />

              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" IsVisible="{Binding !IsConfirmingDelete}">
                <Button Classes="rowAction danger" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" Content="Delete" />
              </StackPanel>
              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0" IsVisible="{Binding IsConfirmingDelete}">
                <TextBlock Text="Delete?" Classes="caption" VerticalAlignment="Center" />
                <Button Classes="rowAction danger" Command="{Binding DeleteCommand}" Content="Yes" />
                <Button Classes="rowAction" Command="{Binding CancelDeleteCommand}" Content="No" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
