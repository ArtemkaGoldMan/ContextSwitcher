<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.ProfilesPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  x:DataType="vm:ProfilesViewModel">
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Profiles" Classes="header" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="switchContext" Content="Add new profile" Command="{Binding AddCommand}" />
    </Grid>

    <TextBlock
      Text="{Binding ErrorMessage}"
      Classes="caption"
      Foreground="{DynamicResource ErrorBrush}"
      TextWrapping="Wrap"
      IsVisible="{Binding HasErrorMessage}" />

    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProfileRowViewModel">
          <Border Classes="panel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
              <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding DisplayName}" Classes="body" />
                <TextBlock Text="Active" Classes="caption" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsActive}" />
              </StackPanel>

              <Button
                Grid.Column="2"
                Classes="switchContext"
                Command="{Binding ActivateCommand}"
                Content="Activate"
                IsEnabled="{Binding !IsActive}"
                Margin="6,0" />

              <Button Grid.Column="3" Classes="rowAction" Command="{Binding EditCommand}" ToolTip.Tip="Edit" Content="Edit" />

              <Button Grid.Column="4" Classes="rowAction" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate" Content="Duplicate" />

              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsConfirmingDelete}">
                <Button Classes="rowAction" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" Content="Delete" Foreground="{DynamicResource ErrorBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsConfirmingDelete}">
                <TextBlock Text="Delete?" Classes="caption" VerticalAlignment="Center" />
                <Button Classes="rowAction" Command="{Binding DeleteCommand}" Content="Yes" Foreground="{DynamicResource ErrorBrush}" />
                <Button Classes="rowAction" Command="{Binding CancelDeleteCommand}" Content="No" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
