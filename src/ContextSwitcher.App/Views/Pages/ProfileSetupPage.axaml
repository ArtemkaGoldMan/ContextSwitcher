<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.ProfileSetupPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="using:ContextSwitcher.App.Resources"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:conv="using:ContextSwitcher.App.Converters"
  xmlns:ctl="using:ContextSwitcher.App.Controls"
  x:DataType="vm:ProfileSetupViewModel">
  <!-- Built only from the shared pieces, so it matches every other screen: FormRow for each labelled
       setting, a dropdown for every pick-one choice, Styles/Templates.axaml for every list row and
       picker, and a "+ Add …" link under every list. -->
  <StackPanel Spacing="20">
    <!-- Header -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <!-- A live preview of the profile: its icon on its accent color, as the rows and the menu bar
           popover will draw it. -->
      <Border Grid.Column="0" Classes="badge" Width="36" Height="36" Background="{Binding AccentBrush}" Margin="0,0,12,0"
              ToolTip.Tip="{x:Static r:Strings.ProfileSetup_Preview}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_ProfilePreview}">
        <Viewbox Classes="icon" Width="17" Height="17">
          <Path Classes="glyph" Data="{Binding Icon, Converter={x:Static conv:ProfileIconConverter.Instance}}" />
        </Viewbox>
      </Border>
      <TextBlock Grid.Column="1" Text="{Binding HeaderText}" Classes="header" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="switchContext" Content="{x:Static r:Strings.ProfileSetup_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="switchContext current" Content="{x:Static r:Strings.ProfileSetup_Save}" Command="{Binding SaveCommand}" IsDefault="True" />
    </Grid>

    <TextBlock
      Text="{Binding ErrorMessage}"
      Classes="caption"
      Foreground="{DynamicResource ErrorBrush}"
      TextWrapping="Wrap"
      IsVisible="{Binding HasErrorMessage}" />

    <!-- Identity -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.ProfileSetup_Identity_Section}" Classes="sectionTitle" />

        <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_DisplayName}">
          <TextBox Text="{Binding DisplayName}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_DisplayName}" />
        </ctl:FormRow>
        <Border Classes="divider" />

        <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_AccentColor}">
          <ComboBox ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding SelectedAccent}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_AccentColor}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AccentChoiceViewModel">
                <StackPanel Orientation="Horizontal">
                  <Panel Classes="leadingIcon">
                    <Ellipse Width="14" Height="14" Fill="{Binding Brush}" />
                  </Panel>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ctl:FormRow>
        <!-- "Custom" reveals the full picker under its dropdown, the way choosing Apple Music reveals
             a playlist - choosing something in a dropdown never opens a different kind of control. -->
        <ColorView
          Color="{Binding AccentColorValue}"
          IsAlphaEnabled="False"
          IsAlphaVisible="False"
          IsVisible="{Binding IsCustomAccent}"
          Width="{StaticResource FieldWidth}"
          HorizontalAlignment="Right"
          AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_CustomColor}" />
        <Border Classes="divider" />

        <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_Icon}">
          <ComboBox ItemsSource="{Binding IconChoices}" SelectedItem="{Binding SelectedIcon}" MaxDropDownHeight="340" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_Icon}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:IconChoiceViewModel">
                <StackPanel Orientation="Horizontal">
                  <Panel Classes="leadingIcon">
                    <Viewbox Classes="icon">
                      <Path Classes="glyph" Data="{Binding Name, Converter={x:Static conv:ProfileIconConverter.Instance}}" />
                    </Viewbox>
                  </Panel>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ctl:FormRow>
      </StackPanel>
    </Border>

    <!-- Apps -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.ProfileSetup_Apps_Section}" Classes="sectionTitle" />
        <TextBlock
          Text="{x:Static r:Strings.ProfileSetup_LaunchOpensTheAppWhen}"
          Classes="caption"
          TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock
          Text="{x:Static r:Strings.ProfileSetup_NoAppsYetAddThe}"
          Classes="caption"
          IsVisible="{Binding !Apps.Count}" />

        <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_AddApp}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                <ContentControl Content="{Binding AppPicker}" ContentTemplate="{StaticResource AppPickerContent}" />
                <Border Classes="divider" />
                <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_TypeAName}" Command="{Binding AddAppCommand}" ctl:PopupActions.ClosesPopup="True"
                        ToolTip.Tip="{x:Static r:Strings.ProfileSetup_ForAnAppThatIsnt}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Border>

    <!-- Browser management -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.ProfileSetup_BrowserManagement_Section}" Classes="sectionTitle" />

        <!-- The browser first: what can be asked of it depends on which it is. -->
        <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_Browser}">
          <ComboBox ItemsSource="{Binding BrowserKindChoices}" SelectedItem="{Binding SelectedBrowserKind}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_Browser}" />
        </ctl:FormRow>
        <Border Classes="divider" />
        <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_OnSwitch}">
          <ComboBox ItemsSource="{Binding BrowserModeChoices}" SelectedItem="{Binding SelectedBrowserMode}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_OnSwitch}" />
        </ctl:FormRow>

        <!-- Safari's tab groups and profiles can't be opened by another app; a Focus filter can. -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowsSafariFocusTip}">
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_SafariFocusTip}" Classes="caption" TextWrapping="Wrap" />
          <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_OpenFocusSettings}" Command="{Binding OpenFocusSettingsCommand}" />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsUrlsMode}">
          <Border Classes="divider" />
          <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_AvoidDuplicateTabs}" Description="{Binding AvoidDuplicateTabsHint}">
            <ToggleSwitch IsChecked="{Binding AvoidDuplicateTabs}" IsEnabled="{Binding CanAvoidDuplicateTabs}" />
          </ctl:FormRow>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsUrlsMode}" Margin="0,6,0,0">
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_StartupURLs}" Classes="caption" />
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_PagesOpenClose}" Classes="caption" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding BrowserUrls}" ItemTemplate="{StaticResource BrowserPageRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBlock Text="{Binding CloseTabsHint}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !CanCloseTabs}" />
          <!-- Every opening re-reads the browser, so the list is what is open right now. -->
          <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_AddUrl}" Command="{Binding UrlTabPicker.LoadCommand}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                  <ContentControl Content="{Binding UrlTabPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                  <Border Classes="divider" />
                  <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_TypeAUrl}" Command="{Binding AddBrowserUrlCommand}" ctl:PopupActions.ClosesPopup="True" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsProfilesMode}" Margin="0,6,0,0">
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_BrowserProfiles}" Classes="caption" />
          <ItemsControl ItemsSource="{Binding BrowserProfiles}" ItemTemplate="{StaticResource BrowserProfileRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_AddBrowserProfile}" Command="{Binding AddBrowserProfileCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Everything below Browser is collapsed by default: a new profile only needs identity,
         apps and browser to be useful, and showing all 12 sections at once was the single
         biggest reason Profile Setup read as a config file (agent.md section 11.1.2). -->
    <Expander Classes="section" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_FocusAndMusic}">
      <Expander.Header>
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_FocusMusic}" Classes="body" FontWeight="SemiBold" />
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_TurnOnAMacOSFocus}" Classes="caption" FontWeight="Normal" TextWrapping="Wrap" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="20">
        <!-- Focus -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_Focus_Section}" Classes="sectionTitle" />
            <TextBlock
              Text="{x:Static r:Strings.ProfileSetup_SwitchesMacOSFocusDoNot}"
              Classes="caption"
              TextWrapping="Wrap" />
            <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_FocusMode}">
              <ComboBox ItemsSource="{Binding Focus.Choices}" SelectedItem="{Binding Focus.Selected}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_FocusMode}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FocusChoiceViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Status}" Classes="caption" Classes.ready="{Binding IsReady}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ctl:FormRow>
            <!-- Turning Focus on goes through a Shortcut the user makes once; say which one is missing. -->
            <!-- macOS only lets other apps switch Focus through a Shortcut. For the modes it ships with,
                 "Create it" writes that Shortcut and Shortcuts asks to add it - one click. -->
            <StackPanel Spacing="8" IsVisible="{Binding Focus.HasHint}">
              <StackPanel Spacing="4" IsVisible="{Binding Focus.IsShortcutMissing}">
                <TextBlock Text="{Binding Focus.MissingShortcutText}" Classes="caption" TextWrapping="Wrap" />
                <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_CreateIt}" Command="{Binding Focus.CreateShortcutCommand}" IsVisible="{Binding Focus.CanCreateShortcut}" />
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding Focus.IsOffShortcutMissing}">
                <TextBlock Text="{Binding Focus.MissingOffShortcutText}" Classes="caption" TextWrapping="Wrap" />
                <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_CreateIt}" Command="{Binding Focus.CreateOffShortcutCommand}" IsVisible="{Binding Focus.CanCreateOffShortcut}" />
              </StackPanel>
              <TextBlock Text="{Binding Focus.ShortcutStatus}" Classes="caption" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" IsVisible="{Binding Focus.HasShortcutStatus}" />
              <StackPanel Orientation="Horizontal" Spacing="18">
                <Button Classes="linkButton secondary" Content="{x:Static r:Strings.ProfileSetup_OpenShortcuts}" Command="{Binding Focus.OpenShortcutsCommand}" />
                <Button Classes="linkButton secondary" Content="{x:Static r:Strings.ProfileSetup_CheckAgain}" Command="{Binding Focus.RecheckCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Media -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_Media_Section}" Classes="sectionTitle" />
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_StartsAPlaylistWhenYou}" Classes="caption" TextWrapping="Wrap" />
            <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_Player}">
              <ComboBox ItemsSource="{Binding Media.Players}" SelectedItem="{Binding Media.SelectedPlayer}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_Player}" />
            </ctl:FormRow>

            <StackPanel Spacing="10" IsVisible="{Binding Media.IsAppleMusic}">
              <Border Classes="divider" />
              <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_Playlist}">
                <ComboBox ItemsSource="{Binding Media.MusicPlaylists}" SelectedItem="{Binding Media.Playlist}" PlaceholderText="{x:Static r:Strings.ProfileSetup_ChooseAPlaylist}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_Playlist}" />
              </ctl:FormRow>
              <!-- Music's playlists are only readable by scripting Music, which opens it - so only on request. -->
              <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_LoadPlaylistsFromMusic}" Command="{Binding Media.LoadMusicPlaylistsCommand}" IsVisible="{Binding Media.CanLoadMusicPlaylists}" ToolTip.Tip="{x:Static r:Strings.ProfileSetup_OpensMusicToReadYour}" />
              <TextBlock Text="{x:Static r:Strings.ProfileSetup_ReadingPlaylistsFromMusic}" Classes="caption" IsVisible="{Binding Media.IsLoadingMusicPlaylists}" />
              <TextBlock Text="{Binding Media.MusicStatus}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Media.HasMusicStatus}" />
            </StackPanel>

            <!-- Spotify won't list playlists to a script; a pasted Share link is the next best thing. -->
            <StackPanel Spacing="10" IsVisible="{Binding Media.IsSpotify}">
              <Border Classes="divider" />
              <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_Playlist}" Description="{x:Static r:Strings.ProfileSetup_InSpotifyShareCopyLink}">
                <TextBox Text="{Binding Media.Playlist}" PlaceholderText="{x:Static r:Strings.ProfileSetup_HttpsOpenSpotifyCom}" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_SpotifyLink}" />
              </ctl:FormRow>
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding Media.HasPlayer}">
              <Border Classes="divider" />
              <ctl:FormRow Title="{x:Static r:Strings.ProfileSetup_PlayWhenSwitchingIn}">
                <ToggleSwitch IsChecked="{Binding Media.AutoPlay}" />
              </ctl:FormRow>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Expander>

    <Expander Classes="section" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_Advanced}">
      <Expander.Header>
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_Advanced}" Classes="body" FontWeight="SemiBold" />
          <TextBlock Text="{x:Static r:Strings.ProfileSetup_DockerContainersLinksAndNotes}" Classes="caption" FontWeight="Normal" TextWrapping="Wrap" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="20">
        <!-- Docker -->
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_Docker_Section}" Classes="sectionTitle" />
            <TextBlock
              Text="{x:Static r:Strings.ProfileSetup_StartsTheContainersThisProfile}"
              Classes="caption"
              TextWrapping="Wrap"
              Margin="0,0,0,6" />
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_StartWhenEntering}" Classes="caption" />
            <ItemsControl ItemsSource="{Binding DockerStart}" ItemTemplate="{StaticResource StringRow}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_AddContainer}" Command="{Binding DockerStartPicker.LoadCommand}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding DockerStartPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                    <Border Classes="divider" />
                    <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_TypeAName}" Command="{Binding AddDockerStartCommand}" ctl:PopupActions.ClosesPopup="True" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Border Classes="divider" Margin="0,8" />

            <TextBlock Text="{x:Static r:Strings.ProfileSetup_StopWhenLeaving}" Classes="caption" />
            <ItemsControl ItemsSource="{Binding DockerStop}" ItemTemplate="{StaticResource StringRow}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_AddContainer}" Command="{Binding DockerStopPicker.LoadCommand}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding DockerStopPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                    <Border Classes="divider" />
                    <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_TypeAName}" Command="{Binding AddDockerStopCommand}" ctl:PopupActions.ClosesPopup="True" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>

        <!-- Quick links -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_QuickLinks_Section}" Classes="sectionTitle" />
            <TextBlock
              Text="{x:Static r:Strings.ProfileSetup_ShownInTheMenuBar}"
              Classes="caption"
              TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding QuickLinks}" ItemTemplate="{StaticResource QuickLinkRow}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_AddQuickLink}" Command="{Binding QuickLinkTabPicker.LoadCommand}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding QuickLinkTabPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                    <Border Classes="divider" />
                    <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_TypeAUrl}" Command="{Binding AddQuickLinkCommand}" ctl:PopupActions.ClosesPopup="True" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>

        <!-- Notes -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_Notes_Section}" Classes="sectionTitle" />
            <TextBlock
              Text="{x:Static r:Strings.ProfileSetup_RemindersShownInTheMenu}"
              Classes="caption"
              TextWrapping="Wrap" />
            <TextBox Text="{Binding NotesText}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" AutomationProperties.Name="{x:Static r:Strings.ProfileSetup_Notes}" />
          </StackPanel>
        </Border>

        <!-- Switch policy: what a failed step does to the rest of the switch. -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static r:Strings.ProfileSetup_IfAStepFails_Section}" Classes="sectionTitle" />
            <TextBlock
              Text="{x:Static r:Strings.ProfileSetup_ASwitchRunsInSteps}"
              Classes="caption"
              TextWrapping="Wrap" />
            <ctl:FormRow
              Title="{x:Static r:Strings.ProfileSetup_KeepGoingAfterAFailed}"
              Description="{x:Static r:Strings.ProfileSetup_OnAStepThatFails}">
              <ToggleSwitch IsChecked="{Binding ContinueOnNonCriticalFailure}" />
            </ctl:FormRow>
            <Border Classes="divider" />
            <ctl:FormRow
              Title="{x:Static r:Strings.ProfileSetup_StepsThatMustWork}"
              Description="{x:Static r:Strings.ProfileSetup_IfAStepTickedHere}" />
            <ItemsControl ItemsSource="{Binding CriticalStepOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CriticalStepOptionViewModel">
                  <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
