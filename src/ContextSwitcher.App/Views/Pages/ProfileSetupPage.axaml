<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.ProfileSetupPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:conv="using:ContextSwitcher.App.Converters"
  xmlns:ctl="using:ContextSwitcher.App.Controls"
  x:DataType="vm:ProfileSetupViewModel">
  <!-- Built only from the shared pieces, so it matches every other screen: FormRow for each labelled
       setting, a dropdown for every pick-one choice, Styles/Templates.axaml for every list row and
       picker, and a "+ Add …" link under every list. -->
  <StackPanel Spacing="20">
    <!-- Header -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
      <!-- A live preview of the profile: its icon on its accent color, as the rows and the menu bar
           popover will draw it. -->
      <Border Grid.Column="0" Classes="badge" Width="36" Height="36" Background="{Binding AccentBrush}" Margin="0,0,12,0"
              ToolTip.Tip="Preview" AutomationProperties.Name="Profile preview">
        <Viewbox Classes="icon" Width="17" Height="17">
          <Path Classes="glyph" Data="{Binding Icon, Converter={x:Static conv:ProfileIconConverter.Instance}}" />
        </Viewbox>
      </Border>
      <TextBlock Grid.Column="1" Text="{Binding HeaderText}" Classes="header" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="switchContext" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="switchContext current" Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
    </Grid>

    <TextBlock
      Text="{Binding ErrorMessage}"
      Classes="caption"
      Foreground="{DynamicResource ErrorBrush}"
      TextWrapping="Wrap"
      IsVisible="{Binding HasErrorMessage}" />

    <!-- Identity -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="IDENTITY" Classes="sectionTitle" />

        <ctl:FormRow Title="Display name">
          <TextBox Text="{Binding DisplayName}" AutomationProperties.Name="Display name" />
        </ctl:FormRow>
        <Border Classes="divider" />

        <ctl:FormRow Title="Accent color">
          <ComboBox ItemsSource="{Binding AccentChoices}" SelectedItem="{Binding SelectedAccent}" AutomationProperties.Name="Accent color">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AccentChoiceViewModel">
                <StackPanel Orientation="Horizontal">
                  <Panel Classes="leadingIcon">
                    <Ellipse Width="14" Height="14" Fill="{Binding Brush}" />
                  </Panel>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ctl:FormRow>
        <!-- "Custom" reveals the full picker under its dropdown, the way choosing Apple Music reveals
             a playlist - choosing something in a dropdown never opens a different kind of control. -->
        <ColorView
          Color="{Binding AccentColorValue}"
          IsAlphaEnabled="False"
          IsAlphaVisible="False"
          IsVisible="{Binding IsCustomAccent}"
          Width="{StaticResource FieldWidth}"
          HorizontalAlignment="Right"
          AutomationProperties.Name="Custom color" />
        <Border Classes="divider" />

        <ctl:FormRow Title="Icon">
          <ComboBox ItemsSource="{Binding IconChoices}" SelectedItem="{Binding SelectedIcon}" MaxDropDownHeight="340" AutomationProperties.Name="Icon">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:IconChoiceViewModel">
                <StackPanel Orientation="Horizontal">
                  <Panel Classes="leadingIcon">
                    <Viewbox Classes="icon">
                      <Path Classes="glyph" Data="{Binding Name, Converter={x:Static conv:ProfileIconConverter.Instance}}" />
                    </Viewbox>
                  </Panel>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ctl:FormRow>
      </StackPanel>
    </Border>

    <!-- Apps -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="APPS" Classes="sectionTitle" />
        <TextBlock
          Text="Launch opens the app when you enter this profile. Close quits it when you leave."
          Classes="caption"
          TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock
          Text="No apps yet — add the ones this profile should open or close."
          Classes="caption"
          IsVisible="{Binding !Apps.Count}" />

        <Button Classes="linkButton" Content="+ Add app">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                <ContentControl Content="{Binding AppPicker}" ContentTemplate="{StaticResource AppPickerContent}" />
                <Border Classes="divider" />
                <Button Classes="linkButton" Content="Type a name…" Command="{Binding AddAppCommand}" ctl:PopupActions.ClosesPopup="True"
                        ToolTip.Tip="For an app that isn't in Applications" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Border>

    <!-- Browser management -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="BROWSER MANAGEMENT" Classes="sectionTitle" />

        <ctl:FormRow Title="On switch">
          <ComboBox ItemsSource="{Binding BrowserModeChoices}" SelectedItem="{Binding SelectedBrowserMode}" AutomationProperties.Name="On switch" />
        </ctl:FormRow>

        <StackPanel Spacing="10" IsVisible="{Binding ShowsBrowserChoice}">
          <Border Classes="divider" />
          <ctl:FormRow Title="Browser">
            <ComboBox ItemsSource="{Binding BrowserKindChoices}" SelectedItem="{Binding SelectedBrowserKind}" AutomationProperties.Name="Browser" />
          </ctl:FormRow>
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding IsUrlsMode}">
          <Border Classes="divider" />
          <ctl:FormRow Title="Avoid duplicate tabs" Description="{Binding AvoidDuplicateTabsHint}">
            <ToggleSwitch IsChecked="{Binding AvoidDuplicateTabs}" IsEnabled="{Binding CanAvoidDuplicateTabs}" />
          </ctl:FormRow>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsUrlsMode}" Margin="0,6,0,0">
          <TextBlock Text="Startup URLs" Classes="caption" />
          <ItemsControl ItemsSource="{Binding BrowserUrls}" ItemTemplate="{StaticResource StringRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- Every opening re-reads the browser, so the list is what is open right now. -->
          <Button Classes="linkButton" Content="+ Add URL" Command="{Binding UrlTabPicker.LoadCommand}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                  <ContentControl Content="{Binding UrlTabPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                  <Border Classes="divider" />
                  <Button Classes="linkButton" Content="Type a URL…" Command="{Binding AddBrowserUrlCommand}" ctl:PopupActions.ClosesPopup="True" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsGroupsMode}" Margin="0,6,0,0">
          <TextBlock Text="Tab groups" Classes="caption" />
          <ItemsControl ItemsSource="{Binding TabGroups}" ItemTemplate="{StaticResource StringRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- No picker: browsers don't tell other apps their tab groups' names. -->
          <Button Classes="linkButton" Content="+ Add tab group" Command="{Binding AddTabGroupCommand}" />
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding IsProfilesMode}" Margin="0,6,0,0">
          <TextBlock Text="Browser profiles" Classes="caption" />
          <ItemsControl ItemsSource="{Binding BrowserProfiles}" ItemTemplate="{StaticResource BrowserProfileRow}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Button Classes="linkButton" Content="+ Add browser profile" Command="{Binding AddBrowserProfileCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Everything below Browser is collapsed by default: a new profile only needs identity,
         apps and browser to be useful, and showing all 12 sections at once was the single
         biggest reason Profile Setup read as a config file (agent.md section 11.1.2). -->
    <Expander Classes="section" AutomationProperties.Name="Focus and music">
      <Expander.Header>
        <StackPanel Spacing="2">
          <TextBlock Text="Focus &amp; music" Classes="body" FontWeight="SemiBold" />
          <TextBlock Text="Turn on a macOS Focus and start a playlist when you switch to this profile." Classes="caption" FontWeight="Normal" TextWrapping="Wrap" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="20">
        <!-- Focus -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="FOCUS" Classes="sectionTitle" />
            <TextBlock
              Text="Switches macOS Focus - Do Not Disturb, Work, Sleep… - when you switch to this profile, so only the notifications you want get through. Switching to a profile without one turns Focus off."
              Classes="caption"
              TextWrapping="Wrap" />
            <ctl:FormRow Title="Focus mode">
              <ComboBox ItemsSource="{Binding Focus.Choices}" SelectedItem="{Binding Focus.Selected}" AutomationProperties.Name="Focus mode">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:FocusChoiceViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Status}" Classes="caption" Classes.ready="{Binding IsReady}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </ctl:FormRow>
            <!-- Turning Focus on goes through a Shortcut the user makes once; say which one is missing. -->
            <!-- macOS only lets other apps switch Focus through a Shortcut. For the modes it ships with,
                 "Create it" writes that Shortcut and Shortcuts asks to add it - one click. -->
            <StackPanel Spacing="8" IsVisible="{Binding Focus.HasHint}">
              <StackPanel Spacing="4" IsVisible="{Binding Focus.IsShortcutMissing}">
                <TextBlock Text="{Binding Focus.MissingShortcutText}" Classes="caption" TextWrapping="Wrap" />
                <Button Classes="linkButton" Content="Create it" Command="{Binding Focus.CreateShortcutCommand}" IsVisible="{Binding Focus.CanCreateShortcut}" />
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding Focus.IsOffShortcutMissing}">
                <TextBlock Text="{Binding Focus.MissingOffShortcutText}" Classes="caption" TextWrapping="Wrap" />
                <Button Classes="linkButton" Content="Create it" Command="{Binding Focus.CreateOffShortcutCommand}" IsVisible="{Binding Focus.CanCreateOffShortcut}" />
              </StackPanel>
              <TextBlock Text="{Binding Focus.ShortcutStatus}" Classes="caption" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" IsVisible="{Binding Focus.HasShortcutStatus}" />
              <StackPanel Orientation="Horizontal" Spacing="18">
                <Button Classes="linkButton secondary" Content="Open Shortcuts ↗" Command="{Binding Focus.OpenShortcutsCommand}" />
                <Button Classes="linkButton secondary" Content="Check again" Command="{Binding Focus.RecheckCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Media -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="MEDIA" Classes="sectionTitle" />
            <TextBlock Text="Starts a playlist when you switch to this profile." Classes="caption" TextWrapping="Wrap" />
            <ctl:FormRow Title="Player">
              <ComboBox ItemsSource="{Binding Media.Players}" SelectedItem="{Binding Media.SelectedPlayer}" AutomationProperties.Name="Player" />
            </ctl:FormRow>

            <StackPanel Spacing="10" IsVisible="{Binding Media.IsAppleMusic}">
              <Border Classes="divider" />
              <ctl:FormRow Title="Playlist">
                <ComboBox ItemsSource="{Binding Media.MusicPlaylists}" SelectedItem="{Binding Media.Playlist}" PlaceholderText="Choose a playlist" AutomationProperties.Name="Playlist" />
              </ctl:FormRow>
              <!-- Music's playlists are only readable by scripting Music, which opens it - so only on request. -->
              <Button Classes="linkButton" Content="Load playlists from Music" Command="{Binding Media.LoadMusicPlaylistsCommand}" IsVisible="{Binding Media.CanLoadMusicPlaylists}" ToolTip.Tip="Opens Music to read your playlists" />
              <TextBlock Text="Reading playlists from Music…" Classes="caption" IsVisible="{Binding Media.IsLoadingMusicPlaylists}" />
              <TextBlock Text="{Binding Media.MusicStatus}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Media.HasMusicStatus}" />
            </StackPanel>

            <!-- Spotify won't list playlists to a script; a pasted Share link is the next best thing. -->
            <StackPanel Spacing="10" IsVisible="{Binding Media.IsSpotify}">
              <Border Classes="divider" />
              <ctl:FormRow Title="Playlist" Description="In Spotify: Share → Copy link to playlist, then paste it here.">
                <TextBox Text="{Binding Media.Playlist}" PlaceholderText="https://open.spotify.com/…" AutomationProperties.Name="Spotify link" />
              </ctl:FormRow>
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding Media.HasPlayer}">
              <Border Classes="divider" />
              <ctl:FormRow Title="Play when switching in">
                <ToggleSwitch IsChecked="{Binding Media.AutoPlay}" />
              </ctl:FormRow>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Expander>

    <Expander Classes="section" AutomationProperties.Name="Advanced">
      <Expander.Header>
        <StackPanel Spacing="2">
          <TextBlock Text="Advanced" Classes="body" FontWeight="SemiBold" />
          <TextBlock Text="Docker containers, links and notes for the dashboard, and what happens when a step fails." Classes="caption" FontWeight="Normal" TextWrapping="Wrap" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="20">
        <!-- Docker -->
        <Border Classes="panel">
          <StackPanel Spacing="6">
            <TextBlock Text="DOCKER" Classes="sectionTitle" />
            <TextBlock
              Text="Starts the containers this profile needs when you switch to it - a local database, say - and stops the ones you list when you leave it."
              Classes="caption"
              TextWrapping="Wrap"
              Margin="0,0,0,6" />
            <TextBlock Text="Start when entering" Classes="caption" />
            <ItemsControl ItemsSource="{Binding DockerStart}" ItemTemplate="{StaticResource StringRow}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Classes="linkButton" Content="+ Add container" Command="{Binding DockerStartPicker.LoadCommand}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding DockerStartPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                    <Border Classes="divider" />
                    <Button Classes="linkButton" Content="Type a name…" Command="{Binding AddDockerStartCommand}" ctl:PopupActions.ClosesPopup="True" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>

            <Border Classes="divider" Margin="0,8" />

            <TextBlock Text="Stop when leaving" Classes="caption" />
            <ItemsControl ItemsSource="{Binding DockerStop}" ItemTemplate="{StaticResource StringRow}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Classes="linkButton" Content="+ Add container" Command="{Binding DockerStopPicker.LoadCommand}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding DockerStopPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                    <Border Classes="divider" />
                    <Button Classes="linkButton" Content="Type a name…" Command="{Binding AddDockerStopCommand}" ctl:PopupActions.ClosesPopup="True" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>

        <!-- Quick links -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="QUICK LINKS" Classes="sectionTitle" />
            <TextBlock
              Text="Shown in the menu bar dashboard while this profile is active, one click to open - your team's board, a dashboard, your inbox."
              Classes="caption"
              TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding QuickLinks}" ItemTemplate="{StaticResource QuickLinkRow}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Classes="linkButton" Content="+ Add quick link" Command="{Binding QuickLinkTabPicker.LoadCommand}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding QuickLinkTabPicker}" ContentTemplate="{StaticResource ChoicePickerContent}" />
                    <Border Classes="divider" />
                    <Button Classes="linkButton" Content="Type a URL…" Command="{Binding AddQuickLinkCommand}" ctl:PopupActions.ClosesPopup="True" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>

        <!-- Notes -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="NOTES" Classes="sectionTitle" />
            <TextBlock
              Text="Reminders shown in the menu bar dashboard while this profile is active - a standup time, today's focus. One per line."
              Classes="caption"
              TextWrapping="Wrap" />
            <TextBox Text="{Binding NotesText}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" AutomationProperties.Name="Notes" />
          </StackPanel>
        </Border>

        <!-- Switch policy: what a failed step does to the rest of the switch. -->
        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="IF A STEP FAILS" Classes="sectionTitle" />
            <TextBlock
              Text="A switch runs in steps: it stops the containers and quits the apps of the profile you're leaving, then changes Focus and opens the apps, browser, containers and music of this one."
              Classes="caption"
              TextWrapping="Wrap" />
            <ctl:FormRow
              Title="Keep going after a failed step"
              Description="On: a step that fails - an app that won't quit, a missing Shortcut - shows as a warning and the rest still runs. Off: the switch stops at the first failure.">
              <ToggleSwitch IsChecked="{Binding ContinueOnNonCriticalFailure}" />
            </ctl:FormRow>
            <Border Classes="divider" />
            <ctl:FormRow
              Title="Steps that must work"
              Description="If a step ticked here fails, the switch stops there and counts as failed, whatever the setting above." />
            <ItemsControl ItemsSource="{Binding CriticalStepOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CriticalStepOptionViewModel">
                  <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
