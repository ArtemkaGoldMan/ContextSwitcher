<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.SettingsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="using:ContextSwitcher.App.Resources"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:conv="using:ContextSwitcher.App.Converters"
  xmlns:ctl="using:ContextSwitcher.App.Controls"
  x:DataType="vm:SettingsViewModel">
  <!-- Every change applies straight away - there is no Save button - and every section says in a
       line what it is for, so nothing here needs the docs to make sense. -->
  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="Auto,*">
      <Border Grid.Column="0" Classes="badge" Width="36" Height="36" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
        <Viewbox Classes="icon" Width="18" Height="18">
          <Path Classes="glyph" Data="{StaticResource IconSliders}" />
        </Viewbox>
      </Border>
      <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
        <TextBlock Text="{x:Static r:Strings.Settings_Settings}" Classes="header" />
        <TextBlock Text="{x:Static r:Strings.Settings_ChangesAreSavedAsYou}" Classes="caption" />
      </StackPanel>
    </Grid>

    <TextBlock
      Text="{Binding ErrorMessage}"
      Classes="caption"
      Foreground="{DynamicResource ErrorBrush}"
      TextWrapping="Wrap"
      IsVisible="{Binding HasErrorMessage}" />

    <!-- Appearance -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_Appearance_Section}" Classes="sectionTitle" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_Language}" Description="{x:Static r:Strings.Settings_Language_Description}">
          <ComboBox ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="{x:Static r:Strings.Settings_Language}" />
        </ctl:FormRow>
        <TextBlock Text="{Binding LanguagePendingText}" Classes="caption" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" IsVisible="{Binding IsLanguagePending}" />
        <Border Classes="divider" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_Theme}" Description="{x:Static r:Strings.Settings_MatchMacOSFollowsTheSystems}">
          <ComboBox ItemsSource="{Binding AppearanceChoices}" SelectedItem="{Binding SelectedAppearance}" AutomationProperties.Name="{x:Static r:Strings.Settings_Theme}" />
        </ctl:FormRow>
        <Border Classes="divider" />
        <ctl:FormRow
          Title="{x:Static r:Strings.Settings_ShowInTheDock}"
          Description="{x:Static r:Strings.Settings_OffContextSwitcherLivesOnly}">
          <ToggleSwitch IsChecked="{Binding ShowDockIcon}" AutomationProperties.Name="{x:Static r:Strings.Settings_ShowInTheDock}" />
        </ctl:FormRow>
        <Border Classes="divider" />
        <ctl:FormRow
          Title="{x:Static r:Strings.Settings_OpenAtLogin}"
          Description="{x:Static r:Strings.Settings_OpenAtLogin_Description}">
          <ToggleSwitch IsChecked="{Binding OpenAtLogin}" IsEnabled="{Binding CanOpenAtLogin}" AutomationProperties.Name="{x:Static r:Strings.Settings_OpenAtLogin}" />
        </ctl:FormRow>
        <TextBlock Text="{Binding OpenAtLoginHint}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasOpenAtLoginHint}" />
        <Button Classes="linkButton" Content="{x:Static r:Strings.Settings_OpenAtLogin_OpenLoginItems}" Command="{Binding OpenLoginItemsCommand}" IsVisible="{Binding NeedsLoginItemApproval}" />
      </StackPanel>
    </Border>

    <!-- Permission -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_Permission_Section}" Classes="sectionTitle" />
        <TextBlock
          Text="{x:Static r:Strings.Settings_ToQuitAppsReadYour}"
          Classes="caption"
          TextWrapping="Wrap" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_ControlOtherApps}" Description="{Binding AutomationStatusText}">
          <Border Classes="statusPill" Classes.allowed="{Binding IsAutomationAllowed}" Classes.denied="{Binding IsAutomationDenied}">
            <TextBlock Text="{Binding AutomationGranted, Converter={x:Static conv:PermissionStatusTextConverter.Instance}}" Classes="caption" FontWeight="SemiBold" />
          </Border>
        </ctl:FormRow>
        <StackPanel Orientation="Horizontal" Spacing="18">
          <Button Classes="linkButton" Content="{x:Static r:Strings.Settings_OpenSystemSettings}" Command="{Binding OpenAutomationSettingsCommand}" />
          <Button Classes="linkButton secondary" Content="{x:Static r:Strings.Settings_CheckAgain}" Command="{Binding RefreshPermissionsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Time tracking -->
    <!-- Switching: asking about everything else open, and the apps never touched -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_Switching_Section}" Classes="sectionTitle" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_AskOnSwitch}" Description="{x:Static r:Strings.Settings_AskOnSwitch_Description}">
          <ToggleSwitch IsChecked="{Binding AskOnSwitch}" AutomationProperties.Name="{x:Static r:Strings.Settings_AskOnSwitch}" />
        </ctl:FormRow>
        <Border Classes="divider" />
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Static r:Strings.Settings_IgnoredApps}" Classes="body" />
          <TextBlock Text="{x:Static r:Strings.Settings_IgnoredApps_Description}" Classes="caption" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding IgnoredApps.Apps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IgnoredAppRowViewModel">
                <Border Classes="listRow">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{Binding HasIcon}">
                      <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="24" Height="24" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="body" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="rowAction" Command="{Binding RemoveCommand}" ToolTip.Tip="{x:Static r:Strings.Common_Remove}" AutomationProperties.Name="{x:Static r:Strings.Common_Remove}">
                      <Viewbox Classes="icon rowAction">
                        <Path Classes="glyph" Data="{DynamicResource IconX}" />
                      </Viewbox>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding IgnoredApps.Message}" Classes="caption" IsVisible="{Binding IgnoredApps.HasMessage}" TextWrapping="Wrap" />
          <!-- The picker reads the installed apps and their icons only when it's opened. -->
          <Button Classes="linkButton" Content="{x:Static r:Strings.ProfileSetup_AddApp}" IsVisible="{Binding IgnoredApps.CanAdd}" Command="{Binding IgnoredApps.OpenPickerCommand}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Width="{StaticResource PickerWidth}">
                  <ContentControl Content="{Binding IgnoredApps.Picker}" ContentTemplate="{StaticResource AppPickerContent}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_TimeTracking_Section}" Classes="sectionTitle" />
        <TextBlock
          Text="{x:Static r:Strings.Settings_RecordsHowLongYouSpend}"
          Classes="caption"
          TextWrapping="Wrap" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_RecordTimePerProfile}">
          <ToggleSwitch IsChecked="{Binding AnalyticsEnabled}" AutomationProperties.Name="{x:Static r:Strings.Settings_RecordTimePerProfile}" />
        </ctl:FormRow>
        <Border Classes="divider" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_KeepHistoryFor}" Description="{x:Static r:Strings.Settings_OlderDaysAreDeletedAutomatically}" IsEnabled="{Binding AnalyticsEnabled}">
          <ComboBox ItemsSource="{Binding RetentionChoices}" SelectedItem="{Binding SelectedRetention}" AutomationProperties.Name="{x:Static r:Strings.Settings_KeepHistoryFor}" />
        </ctl:FormRow>
      </StackPanel>
    </Border>

    <!-- Updates -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_Updates_Section}" Classes="sectionTitle" />
        <TextBlock
          Text="{x:Static r:Strings.Settings_NewVersionsComeFromThe}"
          Classes="caption"
          TextWrapping="Wrap" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_CheckAutomatically}" Description="{x:Static r:Strings.Settings_OnceADayTurnedOff}">
          <ToggleSwitch IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="{x:Static r:Strings.Settings_CheckForUpdatesAutomatically}" />
        </ctl:FormRow>
        <Border Classes="divider" />
        <ctl:FormRow Title="{Binding Updates.CurrentVersionText}" Description="{Binding Updates.StatusText}">
          <Panel>
            <Button Classes="switchContext" Content="{x:Static r:Strings.Settings_CheckNow}" Command="{Binding Updates.CheckNowCommand}" IsVisible="{Binding !Updates.CanInstall}" />
            <Button Classes="switchContext current" Content="{x:Static r:Strings.Settings_InstallAndRestart}" Command="{Binding Updates.InstallCommand}" IsVisible="{Binding Updates.CanInstall}" />
          </Panel>
        </ctl:FormRow>
        <!-- What the update brings, before it is installed: its release's "What's new" list. -->
        <StackPanel Spacing="6" IsVisible="{Binding Updates.HasNotes}">
          <TextBlock Text="{Binding Updates.WhatsNewHeading}" Classes="body" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Updates.AvailableNotes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="•" Classes="caption" Margin="2,0,8,0" />
                  <TextBlock Grid.Column="1" Text="{Binding}" Classes="caption" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding Updates.InstallBlocker}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Updates.HasInstallBlocker}" />
        <Button Classes="linkButton" Content="{Binding Updates.ReleasePageLinkText}" Command="{Binding Updates.OpenReleasePageCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}" />
      </StackPanel>
    </Border>

    <!-- Export and import -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_Transfer_Section}" Classes="sectionTitle" />
        <TextBlock Text="{x:Static r:Strings.Settings_Transfer_Description}" Classes="caption" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="switchContext" Content="{x:Static r:Strings.Settings_Export}" Command="{Binding Transfer.ExportCommand}" />
          <Button Classes="switchContext" Content="{x:Static r:Strings.Settings_Import}" Command="{Binding Transfer.ImportCommand}" />
        </StackPanel>
        <!-- An import replaces every profile, so it is asked about once the file has been checked. -->
        <StackPanel Spacing="8" IsVisible="{Binding Transfer.IsConfirmingImport}">
          <TextBlock Text="{Binding Transfer.ConfirmText}" Classes="body" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="switchContext current" Content="{x:Static r:Strings.Settings_ImportReplace}" Command="{Binding Transfer.ConfirmImportCommand}" />
            <Button Classes="switchContext" Content="{x:Static r:Strings.Settings_ImportCancel}" Command="{Binding Transfer.CancelImportCommand}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Transfer.Message}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Transfer.HasMessage}" />
        <TextBlock Text="{Binding Transfer.Problem}" Classes="caption" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding Transfer.HasProblem}" />
      </StackPanel>
    </Border>

    <!-- Diagnostics: the detailed log, and the report to send when something is wrong -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_Diagnostics_Section}" Classes="sectionTitle" />
        <ctl:FormRow Title="{x:Static r:Strings.Settings_DetailedLog}" Description="{x:Static r:Strings.Settings_DetailedLog_Description}">
          <ToggleSwitch IsChecked="{Binding Diagnostics.DetailedLog}" AutomationProperties.Name="{x:Static r:Strings.Settings_DetailedLog}" />
        </ctl:FormRow>
        <TextBlock Text="{Binding Diagnostics.DetailedLogStatus}" Classes="caption" IsVisible="{Binding Diagnostics.HasDetailedLogStatus}" />
        <Border Classes="divider" />
        <TextBlock Text="{x:Static r:Strings.Settings_Diagnostics_Description}" Classes="caption" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="18">
          <Button Classes="switchContext" Content="{x:Static r:Strings.Settings_CopyDiagnostics}" Command="{Binding Diagnostics.CopyCommand}" />
          <Button Classes="linkButton secondary" Content="{x:Static r:Strings.Settings_ShowLog}" Command="{Binding Diagnostics.ShowLogCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding Diagnostics.Message}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Diagnostics.HasMessage}" />
      </StackPanel>
    </Border>

    <!-- Contact: an email in the person's own mail app, or an issue on GitHub; both copy the
         diagnostics first, to paste in. Nothing is sent from here. -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_Contact_Section}" Classes="sectionTitle" />
        <TextBlock Text="{x:Static r:Strings.Settings_Contact_Description}" Classes="caption" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal">
          <Button Classes="switchContext" Content="{x:Static r:Strings.Settings_Contact_Email}" Command="{Binding Diagnostics.WriteEmailCommand}" Margin="0,0,18,6" />
          <Button Classes="linkButton" Content="{x:Static r:Strings.Settings_Contact_Issue}" Command="{Binding Diagnostics.OpenIssueCommand}" VerticalAlignment="Center" Margin="0,0,18,6" />
          <Button Classes="linkButton secondary" Content="{x:Static r:Strings.Settings_Contact_WhatToWrite}" Command="{Binding Diagnostics.WhatToWriteCommand}" VerticalAlignment="Center" Margin="0,0,0,6" />
        </WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{x:Static r:Strings.Settings_Contact_Address}" Classes="caption" VerticalAlignment="Center" />
          <SelectableTextBlock Text="{Binding Diagnostics.ContactEmail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{Binding Diagnostics.ContactMessage}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding Diagnostics.HasContactMessage}" />
      </StackPanel>
    </Border>

    <!-- About -->
    <Border Classes="panel">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Settings_About_Section}" Classes="sectionTitle" />
        <ctl:FormRow Title="Context Switcher" Description="{x:Static r:Strings.Settings_FreeAndOpenSourceUnder}">
          <Button Classes="linkButton" Content="{x:Static r:Strings.Settings_SupportTheDeveloper}" Command="{Binding SupportDeveloperCommand}" />
        </ctl:FormRow>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
