<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.StatsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
  x:DataType="vm:StatsViewModel">
  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0" Classes="badge" Width="36" Height="36" Background="{DynamicResource BadgeGreenGradient}" Margin="0,0,12,0">
        <Path Classes="icon" Data="{StaticResource IconChartColumn}" Width="18" Height="18" StrokeThickness="1.8" />
      </Border>
      <TextBlock Grid.Column="1" Text="Stats" Classes="header" VerticalAlignment="Center" />
      <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="3">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="switchContext" Classes.current="{Binding IsWeekSelected}" Content="Week" Command="{Binding SelectWeekCommand}" Padding="12,6" BorderThickness="0" />
          <Button Classes="switchContext" Classes.current="{Binding IsMonthSelected}" Content="Month" Command="{Binding SelectMonthCommand}" Padding="12,6" BorderThickness="0" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="panel" IsVisible="{Binding HasBalanceData}">
      <StackPanel Spacing="10">
        <TextBlock Text="BALANCE" Classes="sectionTitle" />
        <lvc:CartesianChart Series="{Binding BalanceSeries}" XAxes="{Binding BalanceXAxes}" Height="280" />
      </StackPanel>
    </Border>

    <Border Classes="panel" IsVisible="{Binding !HasBalanceData}">
      <TextBlock
        Text="No context time recorded for this range yet."
        Classes="caption"
        HorizontalAlignment="Center"
        Margin="0,24" />
    </Border>

    <Border Classes="panel">
      <StackPanel Spacing="4">
        <TextBlock Text="TOTALS BY PROFILE" Classes="sectionTitle" Margin="0,0,0,6" />
        <ItemsControl ItemsSource="{Binding ContextTotals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ContextTotalViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6">
                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Classes="body" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding TotalHoursDisplay}" Classes="body" FontWeight="Medium" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
