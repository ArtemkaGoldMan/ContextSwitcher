<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.StatsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
  x:DataType="vm:StatsViewModel">
  <StackPanel Spacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Stats" Classes="header" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="switchContext" Classes.current="{Binding IsWeekSelected}" Content="Week" Command="{Binding SelectWeekCommand}" />
        <Button Classes="switchContext" Classes.current="{Binding IsMonthSelected}" Content="Month" Command="{Binding SelectMonthCommand}" />
      </StackPanel>
    </Grid>

    <Border Classes="panel" IsVisible="{Binding HasBalanceData}">
      <StackPanel Spacing="8">
        <TextBlock Text="BALANCE" Classes="sectionTitle" />
        <lvc:CartesianChart Series="{Binding BalanceSeries}" XAxes="{Binding BalanceXAxes}" Height="280" />
      </StackPanel>
    </Border>

    <TextBlock
      Text="No context time recorded for this range yet."
      Classes="caption"
      IsVisible="{Binding !HasBalanceData}" />

    <Border Classes="panel">
      <StackPanel Spacing="8">
        <TextBlock Text="TOTALS BY PROFILE" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding ContextTotals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ContextTotalViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">
                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Classes="body" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding TotalHoursDisplay}" Classes="body" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
