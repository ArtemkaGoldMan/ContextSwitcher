<UserControl
  x:Class="ContextSwitcher.App.Views.Pages.StatsPage"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="using:ContextSwitcher.App.Resources"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  x:DataType="vm:StatsViewModel">
  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Border Grid.Column="0" Classes="badge" Width="36" Height="36" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
        <Viewbox Classes="icon" Width="18" Height="18">
          <Path Classes="glyph" Data="{StaticResource IconChartColumn}" />
        </Viewbox>
      </Border>
      <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Stats_Stats}" Classes="header" VerticalAlignment="Center" />
      <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="3">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="switchContext" Classes.current="{Binding IsWeekSelected}" Content="{x:Static r:Strings.Stats_Week}" Command="{Binding SelectWeekCommand}" Padding="12,6" BorderThickness="0" />
          <Button Classes="switchContext" Classes.current="{Binding IsMonthSelected}" Content="{x:Static r:Strings.Stats_Month}" Command="{Binding SelectMonthCommand}" Padding="12,6" BorderThickness="0" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- The same chart as the Dashboard's, bigger; its legend carries the totals per profile. -->
    <Border Classes="panel" IsVisible="{Binding HasBalanceData}">
      <StackPanel Spacing="10">
        <TextBlock Text="{x:Static r:Strings.Stats_TimePerDay_Section}" Classes="sectionTitle" />
        <ContentControl Content="{Binding BalanceChart}" ContentTemplate="{StaticResource BalanceChart}" />
      </StackPanel>
    </Border>

    <Border Classes="panel" IsVisible="{Binding !HasBalanceData}">
      <TextBlock
        Text="{x:Static r:Strings.Stats_NoContextTimeRecordedFor}"
        Classes="caption"
        HorizontalAlignment="Center"
        Margin="0,24" />
    </Border>

  </StackPanel>
</UserControl>
