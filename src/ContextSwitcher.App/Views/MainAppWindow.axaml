<Window
  x:Class="ContextSwitcher.App.Views.MainAppWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:pages="using:ContextSwitcher.App.Views.Pages"
  x:DataType="vm:MainAppViewModel"
  Title="Context Switcher"
  Width="880"
  Height="640"
  MinWidth="640"
  MinHeight="440"
  Background="{DynamicResource AppBackgroundBrush}"
  WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ProfilesViewModel">
      <pages:ProfilesPage />
    </DataTemplate>
    <DataTemplate DataType="vm:ProfileSetupViewModel">
      <pages:ProfileSetupPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <pages:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="vm:StatsViewModel">
      <pages:StatsPage />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,24">
          <Border Classes="badge" Width="30" Height="30" Background="{DynamicResource BadgeBlueGradient}">
            <TextBlock Text="⇄" FontSize="15" FontWeight="Bold" />
          </Border>
          <TextBlock Text="Context Switcher" Classes="body" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="2">
          <Button Classes="navItem" Classes.active="{Binding IsProfilesActive}" Command="{Binding NavigateToProfilesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="badge" Width="26" Height="26" Background="{DynamicResource BadgeBlueGradient}">
                <UniformGrid Columns="2" Rows="2" Width="12" Height="12">
                  <Ellipse Width="4.5" Height="4.5" Fill="White" Margin="0.5" />
                  <Ellipse Width="4.5" Height="4.5" Fill="White" Margin="0.5" />
                  <Ellipse Width="4.5" Height="4.5" Fill="White" Margin="0.5" />
                  <Ellipse Width="4.5" Height="4.5" Fill="White" Margin="0.5" />
                </UniformGrid>
              </Border>
              <TextBlock Text="Profiles" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="navItem" Classes.active="{Binding IsSettingsActive}" Command="{Binding NavigateToSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="badge" Width="26" Height="26" Background="{DynamicResource BadgePurpleGradient}">
                <StackPanel Width="13" Height="13" Spacing="3.5" VerticalAlignment="Center">
                  <Grid>
                    <Rectangle Height="1.4" Fill="White" VerticalAlignment="Center" Opacity="0.95" />
                    <Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Left" />
                  </Grid>
                  <Grid>
                    <Rectangle Height="1.4" Fill="White" VerticalAlignment="Center" Opacity="0.95" />
                    <Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid>
                    <Rectangle Height="1.4" Fill="White" VerticalAlignment="Center" Opacity="0.95" />
                    <Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="Settings" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="navItem" Classes.active="{Binding IsStatsActive}" Command="{Binding NavigateToStatsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="badge" Width="26" Height="26" Background="{DynamicResource BadgeGreenGradient}">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" Height="13">
                  <Rectangle Width="3" Height="7" Fill="White" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                  <Rectangle Width="3" Height="13" Fill="White" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                  <Rectangle Width="3" Height="10" Fill="White" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                </StackPanel>
              </Border>
              <TextBlock Text="Stats" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Name="ContentScroll" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
      <ContentControl Content="{Binding CurrentPage}" Margin="28,24" MaxWidth="640" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
