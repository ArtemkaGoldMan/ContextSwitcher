<Window
  x:Class="ContextSwitcher.App.Views.MainAppWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:pages="using:ContextSwitcher.App.Views.Pages"
  x:DataType="vm:MainAppViewModel"
  Title="Context Switcher"
  Width="880"
  Height="640"
  MinWidth="640"
  MinHeight="440"
  Background="{DynamicResource AppBackgroundBrush}"
  WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ProfilesViewModel">
      <pages:ProfilesPage />
    </DataTemplate>
    <DataTemplate DataType="vm:ProfileSetupViewModel">
      <pages:ProfileSetupPage />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <pages:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="vm:StatsViewModel">
      <pages:StatsPage />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,24">
          <!-- The app's own icon, so the window and the Dock show the same mark. -->
          <Image Source="avares://ContextSwitcher/Assets/Icons/app-mark.png" Width="30" Height="30" />
          <TextBlock Text="Context Switcher" Classes="body" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Spacing="2">
          <Button Classes="navItem" Classes.active="{Binding IsProfilesActive}" Command="{Binding NavigateToProfilesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="badge" Width="26" Height="26" Background="{DynamicResource AccentBrush}">
                <Viewbox Classes="icon">
                  <Path Classes="glyph" Data="{StaticResource IconLayoutGrid}" />
                </Viewbox>
              </Border>
              <TextBlock Text="Profiles" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="navItem" Classes.active="{Binding IsSettingsActive}" Command="{Binding NavigateToSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="badge" Width="26" Height="26" Background="{DynamicResource AccentBrush}">
                <Viewbox Classes="icon">
                  <Path Classes="glyph" Data="{StaticResource IconSliders}" />
                </Viewbox>
              </Border>
              <TextBlock Text="Settings" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="navItem" Classes.active="{Binding IsStatsActive}" Command="{Binding NavigateToStatsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="badge" Width="26" Height="26" Background="{DynamicResource AccentBrush}">
                <Viewbox Classes="icon">
                  <Path Classes="glyph" Data="{StaticResource IconChartColumn}" />
                </Viewbox>
              </Border>
              <TextBlock Text="Stats" Classes="body" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <ScrollViewer Name="ContentScroll" Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}">
        <!-- MaxWidth with HorizontalAlignment="Stretch" centres the column inside this pane, and the
             pane is offset by the 200px rail: at 640 the column left a 300px gutter each side and sat
             100px right of the window's own centre, which reads as "not centred" rather than as a
             deliberate column. Left-aligning instead makes the control shrink to its content's
             desired width, which is narrower still. A cap generous enough that it only binds on very
             wide windows keeps the content filling the pane at every size anyone actually uses. -->
        <ContentControl Content="{Binding CurrentPage}" Margin="28,24" MaxWidth="1100" HorizontalAlignment="Stretch" />
      </ScrollViewer>

      <!-- What went wrong in the last switch, under the profiles you switch from. Pinned below the
           scrolling page rather than inside it, so it is in view however long the list is and never
           covers a row. Only on Profiles: editing a profile or reading stats is not the moment. -->
      <Panel Grid.Row="1" IsVisible="{Binding IsProfilesActive}" Margin="28,0,28,20" MaxWidth="1100">
        <Border Classes="panel notice" Classes.failure="{Binding Profiles.Notice.IsFailure}"
                IsVisible="{Binding Profiles.Notice.IsShown}" AutomationProperties.Name="Switch problems">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Classes="badge noticeBadge" Width="28" Height="28" VerticalAlignment="Top" Margin="0,0,12,0">
              <Viewbox Classes="icon">
                <Path Classes="glyph" Data="{StaticResource IconTriangleAlert}" />
              </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Profiles.Notice.Title}" Classes="body" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Profiles.Notice.TimeText}" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <!-- A bad switch can fail at many steps; past a few lines they scroll here instead of
                   pushing the page out of the window. -->
              <ScrollViewer MaxHeight="132">
                <ItemsControl ItemsSource="{Binding Profiles.Notice.Messages}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Grid ColumnDefinitions="Auto,*">
                        <Ellipse Grid.Column="0" Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="2,7,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding}" Classes="body" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>

            <Button Grid.Column="2" Classes="rowAction" Command="{Binding Profiles.Notice.DismissCommand}" VerticalAlignment="Top" Margin="8,0,0,0"
                    ToolTip.Tip="Close" AutomationProperties.Name="Close notice">
              <Viewbox Classes="icon rowAction">
                <Path Classes="glyph" Data="{StaticResource IconX}" />
              </Viewbox>
            </Button>
          </Grid>
        </Border>
      </Panel>
    </Grid>
  </Grid>
</Window>
