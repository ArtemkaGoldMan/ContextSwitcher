<Window
  x:Class="ContextSwitcher.App.Views.DashboardWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
  x:DataType="vm:DashboardViewModel"
  Title="Context Switcher"
  Width="360"
  MinWidth="320"
  MaxWidth="420"
  SizeToContent="Height"
  CanResize="False"
  WindowDecorations="None"
  ShowInTaskbar="False"
  Topmost="True"
  Background="Transparent"
  TransparencyLevelHint="Transparent"
  WindowStartupLocation="Manual">
  <Border
    Background="{DynamicResource SurfaceBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="1"
    CornerRadius="12"
    BoxShadow="0 8 32 0 #33000000">
    <StackPanel Margin="14" Spacing="12">
      <!-- Header -->
      <StackPanel Spacing="2">
        <TextBlock Text="Context Switcher" Classes="header" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding ActiveContextDisplayName}" Classes="body" />
          <TextBlock Text="{Binding ElapsedDisplay}" Classes="caption" />
        </StackPanel>
      </StackPanel>

      <!-- Switch buttons -->
      <StackPanel Spacing="8">
        <TextBlock Text="SWITCH TO" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding SwitchButtons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SwitchButtonViewModel">
              <Button
                Classes="switchContext"
                Classes.current="{Binding IsCurrent}"
                Command="{Binding SwitchCommand}"
                HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DisplayName}" Classes="body" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Switching…" Classes="caption" IsVisible="{Binding IsSwitching}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSwitching}" Height="3" />
      </StackPanel>

      <!-- Last switch outcome -->
      <StackPanel Spacing="4" IsVisible="{Binding HasLastSwitchWarnings}">
        <TextBlock Text="LAST SWITCH" Classes="sectionTitle" />
        <TextBlock Text="{Binding LastSwitchStatusText}" Classes="body" Foreground="{DynamicResource WarningBrush}" />
        <ItemsControl ItemsSource="{Binding LastSwitchWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Config warnings -->
      <StackPanel Spacing="4" IsVisible="{Binding HasConfigurationWarnings}">
        <TextBlock Text="CONFIGURATION WARNINGS" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding ConfigurationWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="caption" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Quick links -->
      <StackPanel Spacing="4" IsVisible="{Binding HasQuickLinks}">
        <TextBlock Text="QUICK LINKS" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding QuickLinks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QuickLinkViewModel">
              <Button Classes="linkButton" Command="{Binding OpenCommand}" Content="{Binding Title}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Notes -->
      <StackPanel Spacing="4" IsVisible="{Binding HasNotes}">
        <TextBlock Text="NOTES" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Balance chart -->
      <StackPanel Spacing="4" IsVisible="{Binding HasBalanceData}">
        <TextBlock Text="BALANCE (7 DAYS)" Classes="sectionTitle" />
        <lvc:CartesianChart
          Series="{Binding BalanceSeries}"
          XAxes="{Binding BalanceXAxes}"
          Height="120" />
      </StackPanel>

      <!-- Footer -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="linkButton" Command="{Binding OpenSettingsCommand}" Content="Settings" />
        <Button Classes="linkButton" Command="{Binding SupportDeveloperCommand}" Content="Support the developer" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
