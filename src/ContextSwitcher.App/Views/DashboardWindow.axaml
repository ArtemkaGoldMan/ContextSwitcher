<Window
  x:Class="ContextSwitcher.App.Views.DashboardWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
  x:DataType="vm:DashboardViewModel"
  Title="Context Switcher"
  Width="360"
  MinWidth="320"
  MaxWidth="420"
  SizeToContent="Height"
  CanResize="False"
  WindowDecorations="None"
  ShowInTaskbar="False"
  Topmost="True"
  Background="Transparent"
  TransparencyLevelHint="Transparent"
  WindowStartupLocation="Manual">
  <Border
    Background="{DynamicResource SurfaceBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="1"
    CornerRadius="16"
    BoxShadow="0 12 40 0 #40000000">
    <StackPanel Margin="16" Spacing="14">
      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="badge" Width="34" Height="34" Background="{DynamicResource BadgeBlueGradient}" Margin="0,0,10,0">
          <TextBlock Text="⇄" FontSize="16" FontWeight="Bold" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding ActiveContextDisplayName}" Classes="body" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ElapsedDisplay}" Classes="caption" />
        </StackPanel>
      </Grid>

      <!-- Switch buttons -->
      <StackPanel Spacing="8">
        <TextBlock Text="SWITCH TO" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding SwitchButtons}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SwitchButtonViewModel">
              <Button
                Classes="switchContext"
                Classes.current="{Binding IsCurrent}"
                Command="{Binding SwitchCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Width="10" Height="10" CornerRadius="3" Background="{Binding AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding DisplayName}" Classes="body" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Switching…" Classes="caption" IsVisible="{Binding IsSwitching}" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSwitching}" Height="3" CornerRadius="2" />
      </StackPanel>

      <!-- Last switch outcome -->
      <StackPanel Spacing="4" IsVisible="{Binding HasLastSwitchWarnings}">
        <TextBlock Text="LAST SWITCH" Classes="sectionTitle" />
        <TextBlock Text="{Binding LastSwitchStatusText}" Classes="body" Foreground="{DynamicResource WarningBrush}" />
        <ItemsControl ItemsSource="{Binding LastSwitchWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Config warnings -->
      <StackPanel Spacing="4" IsVisible="{Binding HasConfigurationWarnings}">
        <TextBlock Text="CONFIGURATION WARNINGS" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding ConfigurationWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="caption" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Quick links -->
      <StackPanel Spacing="4" IsVisible="{Binding HasQuickLinks}">
        <TextBlock Text="QUICK LINKS" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding QuickLinks}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:QuickLinkViewModel">
              <Button Classes="linkButton" Command="{Binding OpenCommand}" Content="{Binding Title}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Notes -->
      <StackPanel Spacing="4" IsVisible="{Binding HasNotes}">
        <TextBlock Text="NOTES" Classes="sectionTitle" />
        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Balance chart -->
      <StackPanel Spacing="4" IsVisible="{Binding HasBalanceData}">
        <TextBlock Text="BALANCE (7 DAYS)" Classes="sectionTitle" />
        <lvc:CartesianChart
          Series="{Binding BalanceSeries}"
          XAxes="{Binding BalanceXAxes}"
          Height="120" />
      </StackPanel>

      <!-- Footer -->
      <Border Classes="divider" />
      <Grid ColumnDefinitions="*,Auto">
        <Button Grid.Column="0" Classes="linkButton" Command="{Binding OpenAppCommand}" Content="Open App" HorizontalAlignment="Left" />
        <Button Grid.Column="1" Classes="linkButton" Command="{Binding SupportDeveloperCommand}" Content="Support the developer" Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
