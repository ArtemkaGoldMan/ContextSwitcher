<Window
  x:Class="ContextSwitcher.App.Views.OnboardingWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:ctl="using:ContextSwitcher.App.Controls"
  x:DataType="vm:OnboardingViewModel"
  Title="Welcome to Context Switcher"
  Width="620"
  Height="620"
  CanResize="False"
  Background="{DynamicResource AppBackgroundBrush}"
  WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Shared by the Work and Personal steps: the profile's name and its apps, laid out exactly as
         Profile Setup lays them out - same row, same app rows, same picker - since onboarding is
         where someone first learns what these look like. -->
    <DataTemplate x:Key="ProfileStepTemplate" x:DataType="vm:OnboardingProfileViewModel">
      <StackPanel Spacing="16">
        <Border Classes="panel">
          <ctl:FormRow Title="Profile name">
            <TextBox Text="{Binding DisplayName}" PlaceholderText="Profile name" AutomationProperties.Name="Profile name" />
          </ctl:FormRow>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="APPS" Classes="sectionTitle" />
            <TextBlock
              Text="We've pre-filled a few we found installed. Launch opens the app when you enter this profile; Close quits it when you leave."
              Classes="caption"
              TextWrapping="Wrap" />

            <ScrollViewer MaxHeight="200">
              <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No apps chosen yet." Classes="caption" IsVisible="{Binding !HasApps}" />

            <Button Classes="linkButton" Content="+ Add app">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding AppPicker}" ContentTemplate="{StaticResource AppPickerContent}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid RowDefinitions="*,Auto" Margin="28,24">

    <!-- Steps -->
    <Panel Grid.Row="0">

      <!-- 0: Welcome -->
      <StackPanel Spacing="18" VerticalAlignment="Center" IsVisible="{Binding IsWelcomeStep}">
        <Image Source="avares://ContextSwitcher/Assets/Icons/app-mark.png" Width="56" Height="56" HorizontalAlignment="Left" />
        <TextBlock Text="Welcome to Context Switcher" Classes="header" FontSize="26" TextWrapping="Wrap" />
        <TextBlock
          Text="One click flips your Mac between work and personal — opening the apps you need, closing the ones you don't, and keeping the two from bleeding into each other."
          Classes="body"
          TextWrapping="Wrap"
          Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock
          Text="Let's set up two profiles. Takes about a minute, and you can change everything later."
          Classes="body"
          TextWrapping="Wrap" />
      </StackPanel>

      <!-- 1: Work -->
      <ContentControl Content="{Binding Work}" IsVisible="{Binding IsWorkStep}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:OnboardingProfileViewModel">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="40" Height="40" CornerRadius="11" Background="{Binding AccentBrush}">
                  <Viewbox Classes="icon" Width="19" Height="19">
                    <Path Classes="glyph" Data="{StaticResource IconBriefcase}" />
                  </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Your work profile" Classes="header" />
                  <TextBlock Text="Apps to open when you start working, and close when you stop." Classes="caption" />
                </StackPanel>
              </StackPanel>

              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileStepTemplate}" />
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- 2: Personal -->
      <ContentControl Content="{Binding Personal}" IsVisible="{Binding IsPersonalStep}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:OnboardingProfileViewModel">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="40" Height="40" CornerRadius="11" Background="{Binding AccentBrush}">
                  <Viewbox Classes="icon" Width="19" Height="19">
                    <Path Classes="glyph" Data="{StaticResource IconHouse}" />
                  </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Your personal profile" Classes="header" />
                  <TextBlock Text="Apps for your own time — and the work apps you want gone." Classes="caption" />
                </StackPanel>
              </StackPanel>

              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileStepTemplate}" />
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- 3: Done -->
      <StackPanel Spacing="18" VerticalAlignment="Center" IsVisible="{Binding IsDoneStep}">
        <Border Classes="badge" Width="56" Height="56" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
          <Viewbox Classes="icon lg">
            <Path Classes="glyph" Data="{StaticResource IconCircleCheck}" />
          </Viewbox>
        </Border>
        <TextBlock Text="You're set" Classes="header" FontSize="26" />
        <TextBlock
          Text="Finishing will save both profiles and switch you into Work, so you can see exactly what it does."
          Classes="body"
          TextWrapping="Wrap"
          Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="NEXT" Classes="sectionTitle" />
            <TextBlock Text="• Switch anytime from the menu bar icon" Classes="body" />
            <TextBlock Text="• Add browser tabs, Focus and Docker in Profile Setup" Classes="body" />
            <TextBlock Text="• Change a profile's color, icon and apps any time from Open App" Classes="body" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Panel>

    <!-- Footer -->
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,20,0,0">
      <TextBlock
        Text="{Binding ErrorMessage}"
        Classes="caption"
        Foreground="{DynamicResource ErrorBrush}"
        TextWrapping="Wrap"
        IsVisible="{Binding HasErrorMessage}" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StepLabel}" Classes="caption" VerticalAlignment="Center" />

        <Button Grid.Column="1" Classes="linkButton secondary" Content="Skip setup" Command="{Binding SkipCommand}"
                VerticalAlignment="Center" Margin="16,0,0,0" />

        <Button Grid.Column="2" Classes="switchContext" Content="Back" Command="{Binding BackCommand}"
                IsVisible="{Binding CanGoBack}" Margin="0,0,8,0" />

        <Button Grid.Column="3" Classes="switchContext current" Content="Continue" Command="{Binding NextCommand}" IsDefault="True"
                IsVisible="{Binding CanGoNext}" />
        <Button Grid.Column="3" Classes="switchContext current" Content="Finish &amp; switch to Work" Command="{Binding FinishCommand}"
                IsVisible="{Binding IsDoneStep}" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
