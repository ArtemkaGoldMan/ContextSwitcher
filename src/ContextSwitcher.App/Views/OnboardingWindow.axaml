<Window
  x:Class="ContextSwitcher.App.Views.OnboardingWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:r="using:ContextSwitcher.App.Resources"
  xmlns:vm="using:ContextSwitcher.App.ViewModels"
  xmlns:ctl="using:ContextSwitcher.App.Controls"
  x:DataType="vm:OnboardingViewModel"
  Title="{x:Static r:Strings.Onboarding_WelcomeToContextSwitcher}"
  Width="620"
  Height="620"
  CanResize="False"
  Background="{DynamicResource AppBackgroundBrush}"
  WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Shared by the Work and Personal steps: the profile's name and its apps, laid out exactly as
         Profile Setup lays them out - same row, same app rows, same picker - since onboarding is
         where someone first learns what these look like. -->
    <DataTemplate x:Key="ProfileStepTemplate" x:DataType="vm:OnboardingProfileViewModel">
      <StackPanel Spacing="16">
        <Border Classes="panel">
          <ctl:FormRow Title="{x:Static r:Strings.Onboarding_ProfileName}">
            <TextBox Text="{Binding DisplayName}" PlaceholderText="{x:Static r:Strings.Onboarding_ProfileName}" AutomationProperties.Name="{x:Static r:Strings.Onboarding_ProfileName}" />
          </ctl:FormRow>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static r:Strings.Onboarding_Apps_Section}" Classes="sectionTitle" />
            <TextBlock
              Text="{x:Static r:Strings.Onboarding_WevePreFilledAFew}"
              Classes="caption"
              TextWrapping="Wrap" />

            <ScrollViewer MaxHeight="200">
              <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{x:Static r:Strings.Onboarding_NoAppsChosenYet}" Classes="caption" IsVisible="{Binding !HasApps}" />

            <Button Classes="linkButton" Content="{x:Static r:Strings.Onboarding_AddApp}">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Width="{StaticResource PickerWidth}" Spacing="8">
                    <ContentControl Content="{Binding AppPicker}" ContentTemplate="{StaticResource AppPickerContent}" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid RowDefinitions="*,Auto" Margin="28,24">

    <!-- Steps -->
    <Panel Grid.Row="0">

      <!-- 0: Welcome -->
      <StackPanel Spacing="18" VerticalAlignment="Center" IsVisible="{Binding IsWelcomeStep}">
        <Image Source="avares://ContextSwitcher/Assets/Icons/app-mark.png" Width="56" Height="56" HorizontalAlignment="Left" />
        <TextBlock Text="{x:Static r:Strings.Onboarding_WelcomeToContextSwitcher}" Classes="header" FontSize="26" TextWrapping="Wrap" />
        <TextBlock
          Text="{x:Static r:Strings.Onboarding_OneClickFlipsYourMac}"
          Classes="body"
          TextWrapping="Wrap"
          Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock
          Text="{x:Static r:Strings.Onboarding_LetsSetUpTwoProfiles}"
          Classes="body"
          TextWrapping="Wrap" />
      </StackPanel>

      <!-- 1: Work -->
      <ContentControl Content="{Binding Work}" IsVisible="{Binding IsWorkStep}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:OnboardingProfileViewModel">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="40" Height="40" CornerRadius="11" Background="{Binding AccentBrush}">
                  <Viewbox Classes="icon" Width="19" Height="19">
                    <Path Classes="glyph" Data="{StaticResource IconBriefcase}" />
                  </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{x:Static r:Strings.Onboarding_YourWorkProfile}" Classes="header" />
                  <TextBlock Text="{x:Static r:Strings.Onboarding_AppsToOpenWhenYou}" Classes="caption" />
                </StackPanel>
              </StackPanel>

              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileStepTemplate}" />
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- 2: Personal -->
      <ContentControl Content="{Binding Personal}" IsVisible="{Binding IsPersonalStep}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:OnboardingProfileViewModel">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="40" Height="40" CornerRadius="11" Background="{Binding AccentBrush}">
                  <Viewbox Classes="icon" Width="19" Height="19">
                    <Path Classes="glyph" Data="{StaticResource IconHouse}" />
                  </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{x:Static r:Strings.Onboarding_YourPersonalProfile}" Classes="header" />
                  <TextBlock Text="{x:Static r:Strings.Onboarding_AppsForYourOwnTime}" Classes="caption" />
                </StackPanel>
              </StackPanel>

              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProfileStepTemplate}" />
            </StackPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- 3: Done -->
      <StackPanel Spacing="18" VerticalAlignment="Center" IsVisible="{Binding IsDoneStep}">
        <Border Classes="badge" Width="56" Height="56" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
          <Viewbox Classes="icon lg">
            <Path Classes="glyph" Data="{StaticResource IconCircleCheck}" />
          </Viewbox>
        </Border>
        <TextBlock Text="{x:Static r:Strings.Onboarding_YoureSet}" Classes="header" FontSize="26" />
        <TextBlock
          Text="{x:Static r:Strings.Onboarding_FinishingWillSaveBothProfiles}"
          Classes="body"
          TextWrapping="Wrap"
          Foreground="{DynamicResource TextSecondaryBrush}" />
        <Border Classes="panel">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static r:Strings.Onboarding_Next_Section}" Classes="sectionTitle" />
            <TextBlock Text="{x:Static r:Strings.Onboarding_SwitchAnytimeFromTheMenu}" Classes="body" />
            <TextBlock Text="{x:Static r:Strings.Onboarding_AddBrowserTabsFocusAnd}" Classes="body" />
            <TextBlock Text="{x:Static r:Strings.Onboarding_ChangeAProfilesColorIcon}" Classes="body" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Panel>

    <!-- Footer -->
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,20,0,0">
      <TextBlock
        Text="{Binding ErrorMessage}"
        Classes="caption"
        Foreground="{DynamicResource ErrorBrush}"
        TextWrapping="Wrap"
        IsVisible="{Binding HasErrorMessage}" />

      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StepLabel}" Classes="caption" VerticalAlignment="Center" />

        <Button Grid.Column="1" Classes="linkButton secondary" Content="{x:Static r:Strings.Onboarding_SkipSetup}" Command="{Binding SkipCommand}"
                VerticalAlignment="Center" Margin="16,0,0,0" />

        <Button Grid.Column="2" Classes="switchContext" Content="{x:Static r:Strings.Onboarding_Back}" Command="{Binding BackCommand}"
                IsVisible="{Binding CanGoBack}" Margin="0,0,8,0" />

        <Button Grid.Column="3" Classes="switchContext current" Content="{x:Static r:Strings.Onboarding_Continue}" Command="{Binding NextCommand}" IsDefault="True"
                IsVisible="{Binding CanGoNext}" />
        <Button Grid.Column="3" Classes="switchContext current" Content="{x:Static r:Strings.Onboarding_FinishSwitchToWork}" Command="{Binding FinishCommand}"
                IsVisible="{Binding IsDoneStep}" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
